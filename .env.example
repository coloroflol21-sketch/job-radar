# Скопируйте этот файл в .env и заполните значения.
# Файл .env не попадает в git — он в .gitignore.

# Токен от @BotFather
TELEGRAM_BOT_TOKEN=8123456789:AAF-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Ваш chat_id, узнать: npm run chat-id
TELEGRAM_CHAT_ID=123456789

# Почта для отправки откликов. Нужен пароль приложения, а не пароль от аккаунта.
# Gmail: Google Account -> Security -> App passwords (требуется двухэтапная проверка)
SMTP_USER=you@gmail.com
SMTP_PASSWORD=xxxx xxxx xxxx xxxx
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465

# Необязательно: адрес в поле «От кого», если он отличается от SMTP_USER.
# SMTP_FROM=Имя Фамилия <you@gmail.com>
